  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.18",
    "@opentui/core": ">=0.5.12",
    "@opentui/solid": ">=0.5.12",
