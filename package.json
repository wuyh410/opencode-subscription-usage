    "dist",
    "index.js",
    "tui.js",
    "install.ps1",
    "lib",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test",
    "prepack": "npm test"
